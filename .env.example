POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_ME

# Armazenamento de anexos (serviço object-storage do Compose). Use valores
# aleatórios próprios e repita-os em apps/api/.env.
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Monitoramento opcional (docker compose --profile monitoring up -d).
# Gere valores aleatórios, por exemplo com: openssl rand -hex 32
GLITCHTIP_DB_PASSWORD=CHANGE_ME
GLITCHTIP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# SMTP para receber os alertas por e-mail (padrão: só no log do contêiner).
# GLITCHTIP_EMAIL_URL=smtp://usuario:senha@smtp.example.com:587
