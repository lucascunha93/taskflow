DATABASE_URL=postgresql://taskflow:CHANGE_ME@localhost:5432/taskflow?schema=public
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PORT=3000

# Origens exatas autorizadas por CORS, separadas por vírgula. Sem valor, o CORS
# fica desabilitado e a API deve ser servida na mesma origem ou atrás de proxy.
# CORS_ORIGINS=https://app.example.com
# Número de proxies reversos confiáveis à frente da API (usado no rate limiting).
# TRUST_PROXY=1

# Refresh token em cookie HttpOnly. Padrões: 7 dias, Secure ativo e caminho /auth.
# Use REFRESH_COOKIE_SECURE=false somente em desenvolvimento HTTP com navegador
# que recuse cookies Secure em localhost. Ajuste o caminho se a API for servida
# sob um prefixo (por exemplo /api/auth).
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_PATH=/auth

# Configure both values only when using NestJS Observe.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
