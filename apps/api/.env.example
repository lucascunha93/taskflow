DATABASE_URL=postgresql://taskflow:CHANGE_ME@localhost:5432/taskflow?schema=public
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PORT=3000

# Origens exatas autorizadas por CORS, separadas por vírgula. Sem valor, o CORS
# fica desabilitado e a API deve ser servida na mesma origem ou atrás de proxy.
# CORS_ORIGINS=https://app.example.com
# App Android local (WebView em https://localhost): CORS_ORIGINS=https://localhost
# Número de proxies reversos confiáveis à frente da API (usado no rate limiting).
# TRUST_PROXY=1

# Refresh token em cookie HttpOnly. Padrões: 7 dias, Secure ativo e caminho /auth.
# Use REFRESH_COOKIE_SECURE=false somente em desenvolvimento HTTP com navegador
# que recuse cookies Secure em localhost. Ajuste o caminho se a API for servida
# sob um prefixo (por exemplo /api/auth).
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_PATH=/auth

# Anexos em armazenamento compatível com S3. Sem S3_BUCKET e credenciais, os
# anexos respondem 503 e o restante da API funciona. Para o Compose local:
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_PUBLIC_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_BUCKET=taskflow-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_CREATE_BUCKET=true

# Contratação de planos. "fake" habilita o checkout simulado (sem cobrança real),
# somente para desenvolvimento e testes; é recusado com NODE_ENV=production.
# Sem valor, a troca de plano é feita apenas pelo script plan:set.
# BILLING_PROVIDER=fake

# Configure both values only when using NestJS Observe.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
