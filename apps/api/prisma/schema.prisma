generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Plano contratado pela organização; os limites ficam em src/plans/plan-limits.ts.
enum OrganizationPlan {
  FREE
  PRO
  BUSINESS
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Organization {
  id            String           @id @default(uuid()) @db.Uuid
  name          String           @db.VarChar(120)
  slug          String           @unique @db.VarChar(80)
  plan          OrganizationPlan @default(FREE)
  /// Última troca de plano; nulo enquanto permanece no plano inicial.
  planChangedAt DateTime?        @db.Timestamptz(3)
  memberships   Membership[]
  tasks         Task[]
  comments      TaskComment[]
  activities    TaskActivity[]
  notifications Notification[]
  projects      Project[]
  attachments   TaskAttachment[]
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  @@map("organizations")
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(120)
  email               String           @unique @db.VarChar(254)
  passwordHash        String           @db.VarChar(255)
  /// Incrementada para invalidar todos os JWTs já emitidos (troca de senha ou encerramento de sessões).
  sessionVersion      Int              @default(0)
  /// Falhas de login consecutivas desde o último sucesso ou bloqueio.
  failedLoginAttempts Int              @default(0)
  /// Enquanto no futuro, o login da conta é recusado sem verificar a senha.
  lockedUntil         DateTime?        @db.Timestamptz(3)
  memberships         Membership[]
  refreshTokens       RefreshToken[]
  comments            TaskComment[]    @relation("CommentAuthor")
  activities          TaskActivity[]   @relation("ActivityActor")
  notifications       Notification[]   @relation("NotificationRecipient")
  notificationsSent   Notification[]   @relation("NotificationActor")
  attachments         TaskAttachment[] @relation("AttachmentUploader")
  createdTasks        Task[]           @relation("TaskCreator")
  assignedTasks       Task[]           @relation("TaskAssignee")
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  @@map("users")
}

/// Refresh token opaco, guardado somente como hash SHA-256. Tokens de uma mesma
/// sessão compartilham `familyId`; a reutilização de um token já trocado revoga a família.
model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  familyId       String    @db.Uuid
  tokenHash      String    @unique @db.Char(64)
  /// Versão de sessão do usuário na emissão; diferente da atual, o token é recusado.
  sessionVersion Int
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  replacedById   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Task {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  title          String           @db.VarChar(200)
  description    String?          @db.Text
  status         TaskStatus       @default(TODO)
  creatorId      String           @db.Uuid
  assigneeId     String?          @db.Uuid
  /// Projeto da mesma organização (validado no serviço); nulo quando sem projeto.
  projectId      String?          @db.Uuid
  version        Int              @default(1)
  dueDate        DateTime?        @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  activities     TaskActivity[]
  notifications  Notification[]
  attachments    TaskAttachment[]
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  /// Permite que registros dependentes referenciem a tarefa junto com sua organização.
  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, assigneeId])
  @@index([organizationId, projectId, status])
  @@map("tasks")
}

/// Comentário em uma tarefa. A chave composta (taskId, organizationId) garante
/// no banco que o comentário pertence à mesma organização da tarefa.
model TaskComment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  taskId         String       @db.Uuid
  authorId       String       @db.Uuid
  body           String       @db.Text
  editedAt       DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author         User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt, id])
  @@map("task_comments")
}

/// Histórico de uma organização. `taskTitle` guarda o título no momento do
/// evento, para que atividades de tarefas excluídas continuem legíveis.
model TaskActivity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  /// Nulo quando a tarefa foi excluída.
  taskId         String?      @db.Uuid
  taskTitle      String       @db.VarChar(200)
  actorId        String       @db.Uuid
  type           ActivityType
  /// Em TASK_UPDATED: lista de { field, from, to } dos campos alterados.
  changes        Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor          User         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("task_activities")
}

/// Notificação no app para um usuário. Só é exibida enquanto o destinatário
/// pertencer à organização; `taskTitle` guarda o título no momento do evento.
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  taskId         String?          @db.Uuid
  taskTitle      String           @db.VarChar(200)
  actorId        String           @db.Uuid
  type           NotificationType
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  user           User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor          User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Agrupa tarefas de uma organização. Excluir o projeto mantém as tarefas, sem projeto.
model Project {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(120)
  description    String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@unique([organizationId, name])
  @@map("projects")
}

/// Metadados de um arquivo anexado a uma tarefa; o conteúdo fica no
/// armazenamento de objetos sob `storageKey`. A chave composta garante que o
/// anexo pertence à mesma organização da tarefa.
model TaskAttachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  taskId         String       @db.Uuid
  uploaderId     String       @db.Uuid
  fileName       String       @db.VarChar(255)
  contentType    String       @db.VarChar(120)
  size           Int
  storageKey     String       @unique @db.VarChar(300)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  uploader       User         @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt, id])
  /// Soma do armazenamento usado pela organização (cota do plano).
  @@index([organizationId, size])
  @@map("task_attachments")
}
