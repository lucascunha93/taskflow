{
  "/auth/**": {
    "target": "http://localhost:3000",
    "secure": false
  },
  "^/organizations(?:\\?.*)?$": {
    "target": "http://localhost:3000",
    "secure": false
  },
  "^/organizations/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?:\\?.*)?$": {
    "target": "http://localhost:3000",
    "secure": false
  },
  "^/organizations/[^/]+/(?:members|tasks|activity|projects|plan)(?:/[^?]*)?(?:\\?.*)?$": {
    "target": "http://localhost:3000",
    "secure": false
  },
  "^/plans(?:\\?.*)?$": {
    "target": "http://localhost:3000",
    "secure": false
  },
  "^/notifications(?:/[^?]*)?(?:\\?.*)?$": {
    "target": "http://localhost:3000",
    "secure": false
  }
}
